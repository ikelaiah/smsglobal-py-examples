# Example .env file
#copy to .env and fill in secret locally. DO NOT commit the real .env to git
# IBM DB2 DB credentials
DB_USER=your_bd_user_here
DB_PWD=your_db_password_here

# Which DB env to use
DB_ENV=prod

# PostgreSQL credentials (used by update-group-contacts-postgres.py)
PG_USER=your_pg_user_here
PG_PWD=your_pg_password_here

# SMSGlobal REST API credentials (MAC authentication)
SMSGLOBAL_KEY=your_smsglobal_api_key_here
SMSGLOBAL_SECRET=your_smsglobal_api_secret_here